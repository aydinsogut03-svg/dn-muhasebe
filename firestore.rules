rules_version = '2';
// PowerServ+ ortak veritabanı güvenlik kuralları. Firebase konsolu > Firestore Database > Kurallar sekmesine yapıştırın.
service cloud.firestore {
  match /databases/{db}/documents {
    function uyeYol(f) { return /databases/$(db)/documents/firmalar/$(f)/uyeler/$(request.auth.uid); }
    function uye(f) { return request.auth != null && exists(uyeYol(f)) && get(uyeYol(f)).data.aktif == true; }
    function rol(f) { return get(uyeYol(f)).data.rol; }
    function yazar(f) { return uye(f) && rol(f) in ['yonetici', 'muhasebe', 'servis']; }
    function anahtarUyar(key, k) { return k is string && (key.split('~')[0] == k || (key.split('~')[0] == '_' && k == '_' + key.split('~')[1])); }
    function servisIzni(k) { return k in ['servisler', 'ekipmanlar', 'urunler', 'stokHareket', 'kisiler', 'hareketler', 'faturalar']; }
    match /firmalar/{f} {
      allow read: if uye(f);
      allow create: if request.auth != null && request.resource.data.sahip == request.auth.uid;
      allow update: if uye(f) && rol(f) == 'yonetici';
      match /uyeler/{u} {
        allow read: if uye(f) || (request.auth != null && request.auth.uid == u);
        allow create: if (request.auth != null && u == request.auth.uid
            && getAfter(/databases/$(db)/documents/firmalar/$(f)).data.sahip == request.auth.uid
            && !exists(/databases/$(db)/documents/firmalar/$(f))) || (uye(f) && rol(f) == 'yonetici');
        allow update, delete: if uye(f) && rol(f) == 'yonetici';
      }
      // Belge adı (koleksiyon~id) ile k alanı aynı koleksiyonu göstermeli; silme yok (silinen kayıt işaretlenir).
      match /kayit/{key} {
        allow read: if uye(f);
        allow create, update: if yazar(f) && anahtarUyar(key, request.resource.data.k)
          && (rol(f) != 'servis' || servisIzni(request.resource.data.k));
      }
      match /log/{l} {
        allow read: if uye(f) && rol(f) in ['yonetici', 'muhasebe'];
        allow create: if uye(f) && request.resource.data.u == request.auth.uid;
      }
      match /kilit/{k} { allow read, write: if yazar(f); }
    }
  }
}
